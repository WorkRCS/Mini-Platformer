{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Wildbound (MSYS2 UCRT64)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "-S", ".", "-B", "build", "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_PREFIX_PATH=C:/msys64/ucrt64",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Wildbound",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": ["--build", "build", "--config", "Release", "--verbose"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "dependsOn": "Configure Wildbound (MSYS2 UCRT64)",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test C++ Core",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/ctest.exe",
      "args": ["--test-dir", "build", "-C", "Release", "--output-on-failure"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "dependsOn": "Build Wildbound",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Wildbound 3D",
      "type": "process",
      "command": "${workspaceFolder}/build/TinyTrails.exe",
      "options": {
        "cwd": "${workspaceFolder}/build",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "dependsOn": "Build Wildbound",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}