{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wildbound 3D (raylib / MSYS2 UCRT64)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/TinyTrails.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [
        { "name": "PATH", "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Build Wildbound",
      "setupCommands": [
        { "description": "Enable GDB pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}